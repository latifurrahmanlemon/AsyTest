NODE_ENV=development
PORT=3000

# Database
# Supported values: postgres | mysql
DB_PROVIDER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=app_user
DB_PASSWORD=app_password
DB_NAME=asytest
DB_SYNCHRONIZE=true
DB_LOGGING=false

# PostgreSQL example
# DB_PROVIDER=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_NAME=asytest

# MySQL example
# DB_PROVIDER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=root
# DB_NAME=asytest

# Redis / BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE_NAME=email-jobs
QUEUE_WORKER_ENABLED=true
WORKER_CONCURRENCY=5
MAX_JOB_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000

# Auth / security
JWT_ACCESS_TOKEN_SECRET=replace-with-a-long-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=1d
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
APP_ENCRYPTION_KEY=replace-with-a-long-encryption-key
