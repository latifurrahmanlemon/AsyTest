{
  "name": "async-email-job-service",
  "version": "1.0.0",
  "description": "A small NestJS backend that simulates async email jobs with retries and structured logs.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "db:migration:create": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:create",
    "db:migration:generate": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:generate",
    "db:migration:run": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:run",
    "db:migration:revert": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:revert",
    "db:migration:show": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:show",
    "db:seed:admin": "ts-node src/scripts/seed-admin.ts",
    "db:seed:admin:prod": "node dist/scripts/seed-admin.js",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/config": "^4.0.2",
    "@nestjs/common": "^11.1.1",
    "@nestjs/core": "^11.1.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.1",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.56.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.7.0",
    "mysql2": "^3.15.3",
    "nodemailer": "^7.0.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.1",
    "@types/jest": "^29.5.14",
    "@types/nodemailer": "^6.4.17",
    "@types/node": "^22.14.1",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
